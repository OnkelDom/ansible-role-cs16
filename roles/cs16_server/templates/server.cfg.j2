// Managed by Ansible
hostname "{{ cs16_hostname }}"
sv_lan "{{ 0 if cs16_public else 1 }}"
sv_password "{{ cs16_password }}"
rcon_password ""
sv_region "{{ cs16_sv_region }}"

sv_maxrate "{{ cs16_sv_maxrate }}"
sv_minrate "{{ cs16_sv_minrate }}"
sv_maxupdaterate "{{ cs16_sv_maxupdaterate }}"
sv_minupdaterate "{{ cs16_sv_minupdaterate }}"
sv_timeout "60"

mp_autokick "0"
mp_autoteambalance "1"
mp_limitteams "2"
mp_friendlyfire "0"
mp_freezetime "5"
mp_buytime "1.5"
mp_roundtime "3"
mp_c4timer "35"
mp_startmoney "800"
mp_timelimit "25"
mp_flashlight "1"
mp_footsteps "1"
mp_falldamage "1"

sv_voiceenable "1"
sv_alltalk "0"
sv_allowdownload "1"
sv_allowupload "1"
log "on"

exec banned_user.cfg
exec banned_ip.cfg
writeid
writeip

